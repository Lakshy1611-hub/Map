{
  "name": "india-map-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Modern responsive India map search and high-quality PDF downloader.",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev frontend -p 3000",
    "dev:backend": "node backend/server.js",
    "build": "next build frontend",
    "start": "concurrently \"next start frontend -p 3000\" \"node backend/server.js\"",
    "lint": "next lint frontend"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "@types/leaflet": "^1.9.16"
  }
}
